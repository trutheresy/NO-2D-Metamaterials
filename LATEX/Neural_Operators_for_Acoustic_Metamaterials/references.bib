@article{gabor1946theory,
  abstract = {The paper develops a mathematical theory of communication based on the representation of signals as a combination of elementary signals that are localized simultaneously in time and frequency (Gabor atoms / logons). It introduces the information cell picture of the time-frequency plane and analyzes how messages can be encoded and transmitted with finite bandwidth and duration, forming the foundation of Gabor analysis used in modern time-frequency and wavelet signal representations.},
  title={Theory of communication},
  author={Gabor, Dennis},
  journal={Journal of the Institution of Electrical Engineers - Part III: Radio and Communication Engineering},
  volume={93},
  number={26},
  pages={429--441},
  year={1946}
}
